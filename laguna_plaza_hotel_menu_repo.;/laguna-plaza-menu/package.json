{
  "name": "laguna-plaza-cardapio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cardápio digital do Laguna Plaza Hotel & Restaurante Mandi — Vite + React + TypeScript + Tailwind, hospedado no Cloudflare Pages.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=laguna-plaza-cardapio",
    "db:init": "wrangler d1 execute laguna_plaza_db --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute laguna_plaza_db --remote --file=./schema.sql"
  },
  "dependencies": {
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250121.0",
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.11",
    "wrangler": "^3.101.0"
  }
}
